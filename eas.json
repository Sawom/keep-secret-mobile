{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    },
    "production-apk": {
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://keep-secret-backend.vercel.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "770566808078-la41u98h63ieokoftu869nhndtq13sj0.apps.googleusercontent.com"
      }
    }
  }
}