{
  "expo": {
    "name": "KeepSecret",
    "slug": "keepsecret-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "keepsecret",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.keepsecret.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101827"
      },
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-google-signin/google-signin"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101827"
    },
    "extra": {
      "eas": {
        "projectId": "b013a689-1b3d-4daa-bbdc-fe7f317a678a"
      }
    }
  }
}
